    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.0.0",
    "vue-tsc": "3.3.7",
    "playwright": "1.63.0"
  }
